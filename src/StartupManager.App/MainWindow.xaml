<Window x:Class="StartupManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="启动项管理器"
        Width="1360"
        Height="880"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#F3F3F3"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="/Assets/StartupManager.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Native window chrome, styled after the approved prototype titlebar. -->
        <Border x:Name="TitleBar"
                Grid.Row="0"
                Background="{StaticResource TitleBarBackgroundBrush}"
                BorderBrush="{StaticResource TitleBarDividerBrush}"
                BorderThickness="0,0,0,1"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0">
                    <Border Width="22" Height="22" CornerRadius="5" SnapsToDevicePixels="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2B88D8" Offset="0" />
                                <GradientStop Color="#005A9E" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#000000"
                                              BlurRadius="2"
                                              ShadowDepth="1"
                                              Opacity="0.18" />
                        </Border.Effect>
                        <Viewbox Width="13" Height="13">
                            <Canvas Width="24" Height="24">
                                <Path Data="M13,2 L4.6,13.4 L10.3,13.4 L9.2,22 L17.8,10.5 L12.2,10.5 Z"
                                      Fill="#FFFFFF" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="启动项管理器"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="#1B1B1B"
                               TextOptions.TextFormattingMode="Ideal" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource CaptionButtonStyle}"
                            Click="MinimizeButton_Click"
                            ToolTip="最小化"
                            AutomationProperties.AutomationId="CaptionMinimize"
                            AutomationProperties.Name="最小化">
                        <Path Width="10"
                              Height="10"
                              Data="M1,5 H9"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1"
                              Stretch="None"
                              SnapsToDevicePixels="True" />
                    </Button>

                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource CaptionButtonStyle}"
                            Click="MaximizeButton_Click"
                            ToolTip="最大化"
                            AutomationProperties.AutomationId="CaptionMaximize"
                            AutomationProperties.Name="最大化">
                        <Path x:Name="MaximizeGlyph"
                              Width="10"
                              Height="10"
                              Data="M1,1 H9 V9 H1 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1"
                              Stretch="None"
                              SnapsToDevicePixels="True" />
                    </Button>

                    <Button x:Name="CloseButton"
                            Style="{StaticResource CloseCaptionButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="关闭"
                            AutomationProperties.AutomationId="CaptionClose"
                            AutomationProperties.Name="关闭">
                        <Path Width="10"
                              Height="10"
                              Data="M1,1 L9,9 M9,1 L1,9"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1"
                              Stretch="None"
                              SnapsToDevicePixels="True" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- WebView2 fills the area below the native titlebar. The 5px inner
             margin leaves WPF hit-testable edges for WindowChrome resizing. -->
        <Grid Grid.Row="1" Background="{StaticResource PageBackgroundBrush}">
            <wv2:WebView2 x:Name="WebView"
                          Margin="5,0,5,5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Visibility="Collapsed" />

            <Border x:Name="LoadingOverlay"
                    Background="{StaticResource PageBackgroundBrush}"
                    Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="11" HorizontalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2B88D8" Offset="0" />
                                <GradientStop Color="#005A9E" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Viewbox Width="27" Height="27">
                            <Canvas Width="24" Height="24">
                                <Path Data="M13,2 L4.6,13.4 L10.3,13.4 L9.2,22 L17.8,10.5 L12.2,10.5 Z"
                                      Fill="#FFFFFF" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="启动项管理器"
                               Margin="0,14,0,0"
                               HorizontalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="正在加载界面…"
                               Margin="0,4,0,16"
                               HorizontalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <ProgressBar Width="150"
                                 Height="3"
                                 IsIndeterminate="True"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="#E4E5E7"
                                 BorderThickness="0" />
                </StackPanel>
            </Border>

            <Border x:Name="ErrorOverlay"
                    Background="{StaticResource PageBackgroundBrush}"
                    Visibility="Collapsed">
                <Border MaxWidth="520"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="32"
                        Background="#FFFFFF"
                        BorderBrush="#E5E5E5"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="2" Opacity="0.08" />
                    </Border.Effect>
                    <StackPanel>
                        <Border Width="44"
                                Height="44"
                                CornerRadius="22"
                                Background="#FDECEA"
                                HorizontalAlignment="Center">
                            <TextBlock Text="!"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource DangerBrush}" />
                        </Border>
                        <TextBlock x:Name="ErrorTitle"
                                   Text="界面加载失败"
                                   Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="ErrorMessage"
                                   Margin="0,8,0,20"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="12.5"
                                   LineHeight="19"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="RetryButton"
                                    Content="重试"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="RetryButton_Click"
                                    AutomationProperties.AutomationId="ErrorRetry"
                                    AutomationProperties.Name="重试" />
                            <Button x:Name="InstallWebViewButton"
                                    Content="安装 WebView2 运行时"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="InstallWebViewButton_Click"
                                    Visibility="Collapsed"
                                    AutomationProperties.Name="安装 WebView2 运行时" />
                            <Button x:Name="OpenLogsButton"
                                    Content="打开日志"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenLogsButton_Click"
                                    AutomationProperties.Name="打开日志文件夹" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
